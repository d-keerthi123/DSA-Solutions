class Solution {
    public int evalRPN(String[] tokens) {
        
        Stack<Integer> st=new Stack<>();

        for(int i=0;i<tokens.length;i++){
            String s=tokens[i];

            //if s is a number , push it into stack
            if(!s.equals("+") && !s.equals("-") && !s.equals("*") && !s.equals("/")){
                st.push(Integer.parseInt(s));
            }
            else{
                int result=0;

                int n1=st.pop();//2nd operand
                int n2=st.pop();//1st operand

                if(s.equals("*")){
                    result=n2*n1;
                }
                else if(s.equals("/")){
                    result=n2/n1;
                }
                else if(s.equals("+")){
                    result=n2+n1;
                }
                else if(s.equals("-")){
                    result=n2-n1;
                }

                st.push(result);
            }
        }

        return st.pop();
    }
}
